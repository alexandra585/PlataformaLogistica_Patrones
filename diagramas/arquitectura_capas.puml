@startuml arquitectura_capas
skinparam defaultFontSize 11
skinparam packageStyle rectangle
title Arquitectura por capas de AppLogistica (versión final)

package "Presentación (uni.formularios)" as P {
  [LoginView]
  [PrincipalView]
  [EnvioView / SeguimientoView / ManifiestoView]
  [EmpleadoView / NominaEmpleadoView / BoletaPagoView]
  [ReporteView / DesbloqueoUsuariosView]
}
package "Control (uni.controller) - GRASP Controlador" as C {
  [EnvioController / EmpleadoController / ClienteController]
  [RegistroEnvioFacade]
  [GestorComandos / MenuComandos]
}
package "Negocio (uni.service + uni.entity + uni.util)" as N {
  [State / Observer / Command / Memento]
  [Factory / Abstract Factory / Builder / Prototype]
  [Adapter / Decorator / Composite / Proxy]
  [GRASP: EmpleadoNomina, GeneradorBoleta, ControlAccesoLogin]
}
package "Reportes (uni.reportes)" as R {
  [Reporte (Bridge) + 7 plantillas .jrxml\n(gráficos de barras y circulares)]
}
package "Datos (uni.dao + uni.database)" as D {
  [DAOs con procedimientos almacenados]
  [AccesoDB (Singleton)]
}
database "MySQL 8\nlogistica" as DB
P --> C
C --> N
P --> R
R --> D
N --> D
D --> DB
@enduml
