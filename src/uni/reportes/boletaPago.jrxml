<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="boletaPago" language="java" pageWidth="595" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="25" bottomMargin="20" uuid="40275e3d-7601-4148-8f87-5db3fd04f479">
<parameter name="P_IDBOLETA" class="java.lang.Integer"><parameterDescription><![CDATA[Boleta a imprimir]]></parameterDescription></parameter>
<queryString language="SQL"><![CDATA[SELECT b.idboleta, b.idempleado, b.periodo, b.sueldo_basico, b.horas_extras, b.monto_horas_extras,
       b.regimen, b.aporte_pension, b.descuento_salud, b.total_ingresos, b.total_descuentos, b.sueldo_neto,
       b.fecha_emision, CONCAT(e.apellidos, ', ', e.nombre) AS nombre, e.area, e.rol, s.nombre AS sucursal
FROM boletas_pago b
JOIN empleados e ON e.idempleado = b.idempleado
JOIN sucursales s ON s.idsucursal = e.idsucursal
WHERE b.idboleta = $P{P_IDBOLETA}]]></queryString>
<field name="idboleta" class="java.lang.Integer"/>
<field name="idempleado" class="java.lang.String"/>
<field name="periodo" class="java.lang.String"/>
<field name="sueldo_basico" class="java.math.BigDecimal"/>
<field name="horas_extras" class="java.lang.Integer"/>
<field name="monto_horas_extras" class="java.math.BigDecimal"/>
<field name="regimen" class="java.lang.String"/>
<field name="aporte_pension" class="java.math.BigDecimal"/>
<field name="descuento_salud" class="java.math.BigDecimal"/>
<field name="total_ingresos" class="java.math.BigDecimal"/>
<field name="total_descuentos" class="java.math.BigDecimal"/>
<field name="sueldo_neto" class="java.math.BigDecimal"/>
<field name="fecha_emision" class="java.sql.Timestamp"/>
<field name="nombre" class="java.lang.String"/>
<field name="area" class="java.lang.String"/>
<field name="rol" class="java.lang.String"/>
<field name="sucursal" class="java.lang.String"/>
