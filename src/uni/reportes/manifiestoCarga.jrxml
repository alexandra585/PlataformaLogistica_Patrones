<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="manifiestoCarga" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" whenNoDataType="NoDataSection" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="1443970a-d167-431c-94bb-e12c2720f1d3">
<style name="Fila" mode="Opaque" backcolor="#FFFFFF"><conditionalStyle><conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression><style mode="Opaque" backcolor="#F3F7FB"/></conditionalStyle></style>
<parameter name="P_MANIFIESTO" class="java.lang.String"><parameterDescription><![CDATA[Código del manifiesto (raíz del Composite)]]></parameterDescription><defaultValueExpression><![CDATA["MF-2026-0458"]]></defaultValueExpression></parameter>
<queryString language="SQL"><![CDATA[WITH RECURSIVE arbol AS (
    SELECT idunidad, tipo, idpadre FROM unidades_carga WHERE idunidad = $P{P_MANIFIESTO}
    UNION ALL
    SELECT u.idunidad, u.tipo, u.idpadre FROM unidades_carga u JOIN arbol a ON u.idpadre = a.idunidad)
SELECT a.idunidad AS contenedor, a.tipo AS tipo_contenedor, d.codigo, e.nombre_dest AS destinatario,
       di.distrito, e.peso_kg, e.estado, r.fecha AS fecha_ruta, r.placa, z.nombre AS zona,
       CONCAT(s.nombre, ' ', s.apellidos) AS supervisor
FROM arbol a
JOIN unidad_detalle d ON d.idunidad = a.idunidad
JOIN envios e ON e.codigo = d.codigo
LEFT JOIN direcciones di ON di.iddireccion = e.iddir_destino
JOIN unidades_carga m ON m.idunidad = $P{P_MANIFIESTO}
JOIN rutas r ON r.idruta = m.idruta
JOIN zonas z ON z.idzona = r.idzona
JOIN empleados s ON s.idempleado = r.idsupervisor
ORDER BY a.idunidad, d.codigo]]></queryString>
<field name="contenedor" class="java.lang.String"/>
<field name="tipo_contenedor" class="java.lang.String"/>
<field name="codigo" class="java.lang.String"/>
<field name="destinatario" class="java.lang.String"/>
<field name="distrito" class="java.lang.String"/>
<field name="peso_kg" class="java.math.BigDecimal"/>
<field name="estado" class="java.lang.String"/>
<field name="fecha_ruta" class="java.sql.Date"/>
<field name="placa" class="java.lang.String"/>
<field name="zona" class="java.lang.String"/>
<field name="supervisor" class="java.lang.String"/>
<variable name="TOTAL_REG" class="java.lang.Integer" resetType="Report" calculation="Count"><variableExpression><![CDATA[$F{codigo}]]></variableExpression><initialValueExpression><![CDATA[Integer.valueOf(0)]]></initialValueExpression></variable>
<variable name="TOTAL_PESO" class="java.math.BigDecimal" resetType="Report" calculation="Sum"><variableExpression><![CDATA[$F{peso_kg}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
<group name="Contenedor"><groupExpression><![CDATA[$F{contenedor}]]></groupExpression><groupHeader><band height="22"><rectangle><reportElement mode="Opaque" x="0" y="4" width="555" height="18" forecolor="#DEEAF6" backcolor="#DEEAF6" uuid="3a3bfe36-a140-432b-9984-e7ee557e1b3a"/></rectangle><textField isBlankWhenNull="true"><reportElement x="0" y="4" width="555" height="18" forecolor="#1F4E79" uuid="0de3fd5f-e9de-4d77-ab6b-88ff45c6188d"/><box leftPadding="3" rightPadding="3"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{tipo_contenedor} + " " + $F{contenedor}]]></textFieldExpression></textField></band></groupHeader><groupFooter><band height="20"><line><reportElement x="0" y="1" width="555" height="1" forecolor="#9DB6CF" uuid="e1f877d7-6b3e-44ee-9935-35cbc094442a"/><graphicElement><pen lineWidth="1.0"/></graphicElement></line><textField isBlankWhenNull="true"><reportElement x="0" y="2" width="555" height="16" forecolor="#1F4E79" uuid="f3147698-845a-4c69-b721-066bad989290"/><box leftPadding="3" rightPadding="3"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["Paquetes en " + $F{contenedor} + ": " + $V{Contenedor_COUNT}]]></textFieldExpression></textField></band></groupFooter></group>
<background><band splitType="Stretch"/></background>
<title><band height="72" splitType="Stretch"><rectangle><reportElement mode="Opaque" x="0" y="0" width="555" height="62" forecolor="#1F4E79" backcolor="#1F4E79" uuid="ad6c098c-fa6e-4fb2-ac86-cc5dce18ea47"/></rectangle><staticText><reportElement x="10" y="4" width="375" height="16" forecolor="#C8DCF0" uuid="0b768d7f-d172-406f-ac05-a4f4726cb9aa"/><box leftPadding="3" rightPadding="3"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="false"/></textElement><text><![CDATA[LogiRuta Perú S.A.C. · Plataforma de logística y seguimiento]]></text></staticText><staticText><reportElement x="10" y="20" width="375" height="24" forecolor="#FFFFFF" uuid="e9157abc-79c5-4865-85bd-7bb628de8395"/><box leftPadding="3" rightPadding="3"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="17" isBold="true"/></textElement><text><![CDATA[MANIFIESTO DE CARGA]]></text></staticText><textField isBlankWhenNull="true"><reportElement x="10" y="44" width="375" height="16" forecolor="#E1ECF7" uuid="a098345e-9272-4014-98cf-c9695677a89f"/><box leftPadding="3" rightPadding="3"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="false"/></textElement><textFieldExpression><![CDATA["Manifiesto " + $P{P_MANIFIESTO}]]></textFieldExpression></textField><textField pattern="dd/MM/yyyy HH:mm" isBlankWhenNull="true"><reportElement x="385" y="8" width="160" height="16" forecolor="#FFFFFF" uuid="6f383c10-fbd0-4ebb-a48a-ba7565602d5c"/><box leftPadding="3" rightPadding="3"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="false"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField><staticText><reportElement x="385" y="26" width="160" height="16" forecolor="#C8DCF0" uuid="6601735f-d18d-4275-a339-7a6eb2ca656f"/><box leftPadding="3" rightPadding="3"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false"/></textElement><text><![CDATA[AppLogistica · JasperReports]]></text></staticText></band></title>
<pageHeader><band height="20"><textField isBlankWhenNull="true"><reportElement x="0" y="0" width="555" height="18" forecolor="#333333" uuid="6eb9cfed-8bf7-459e-888e-c14246ec70ce"/><box leftPadding="3" rightPadding="3"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{fecha_ruta} == null ? "" : "Ruta del " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{fecha_ruta}) + "  ·  Zona: " + $F{zona} + "  ·  Vehículo: " + $F{placa} + "  ·  Supervisor: " + $F{supervisor}]]></textFieldExpression></textField></band></pageHeader>
