        <textFieldExpression><![CDATA["Entregados: " + $V{TOT_ENT} + "    A tiempo: " + $V{TOT_ATI} + "    Cumplimiento global: " + ($V{TOT_ENT}.longValue() == 0 ? "-" : new java.text.DecimalFormat("0.0").format(100.0 * $V{TOT_ATI} / $V{TOT_ENT}) + " %")]]></textFieldExpression>
    </textField>

