<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cumplimientoTiempos" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" whenNoDataType="NoDataSection" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="51fb186d-28b3-4ff7-877c-337e8fcb5598">
<style name="Fila" mode="Opaque" backcolor="#FFFFFF"><conditionalStyle><conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression><style mode="Opaque" backcolor="#F3F7FB"/></conditionalStyle></style>
<queryString language="SQL"><![CDATA[SELECT v.servicio, t.descripcion, t.dias_entrega,
       CAST(v.entregados AS SIGNED) AS entregados, CAST(v.a_tiempo AS SIGNED) AS a_tiempo,
       ROUND(100 * v.a_tiempo / v.entregados, 1) AS cumplimiento
FROM vw_cumplimiento_tiempos v
JOIN tipos_servicio t ON t.idservicio = v.servicio
ORDER BY v.servicio]]></queryString>
<field name="servicio" class="java.lang.String"/>
<field name="descripcion" class="java.lang.String"/>
<field name="dias_entrega" class="java.lang.Integer"/>
<field name="entregados" class="java.lang.Long"/>
<field name="a_tiempo" class="java.lang.Long"/>
<field name="cumplimiento" class="java.math.BigDecimal"/>
<variable name="TOT_ENT" class="java.lang.Long" resetType="Report" calculation="Sum"><variableExpression><![CDATA[$F{entregados}]]></variableExpression><initialValueExpression><![CDATA[Long.valueOf(0L)]]></initialValueExpression></variable>
<variable name="TOT_ATI" class="java.lang.Long" resetType="Report" calculation="Sum"><variableExpression><![CDATA[$F{a_tiempo}]]></variableExpression><initialValueExpression><![CDATA[Long.valueOf(0L)]]></initialValueExpression></variable>
<background><band splitType="Stretch"/></background>
